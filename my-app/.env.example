# Use a verified staging project first. Existing production requires the audit
# and approved rollout in ../ops/SUPABASE_ROLLOUT.md before connecting this code.
# Public URL and anon/publishable key only; never expose a service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional server-only MyMemory contact email. Never use NEXT_PUBLIC_ for this.
MYMEMORY_EMAIL=
